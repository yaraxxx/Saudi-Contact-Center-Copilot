# Your own Gemini key from https://aistudio.google.com/apikey (free tier is enough to develop).
# Do not put course-provided or employer keys in a public portfolio repo.
GEMINI_API_KEY=
DEFAULT_GOOGLE_MODEL=gemini-2.5-flash
# Key that clients must send as "Authorization: Bearer <key>" to the FastAPI backend.
USER_API_KEY=change-me

# Optional
EVAL_JUDGE_MODEL=gemini-2.5-flash
API_BASE_URL=http://localhost:8000
PHOENIX_URL=http://127.0.0.1:6006
# POLICY_DIR=data/policies
# ENABLE_TRACING=1
